              {
                "color": "orange",
                "value": 2
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      }
    },
    {
      "id": 14,
      "type": "barchart",
      "title": "Outcomes by class (7d)",
      "description": "Which classes are being won and lost.",
