                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      }
    },
    {
      "id": 13,
      "type": "stat",
      "title": "Booking latency p90",
      "description": "Time from the opening to the place being taken. Observed bookings land at 0.5-0.9s; drifting towards seconds means losing places to faster athletes.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VICTORIAMETRICS}"
      },
      "gridPos": {
        "h": 4,
        "w": 9,
