# Copy to .env and fill in. .env is gitignored; .env.example is not, so keep
# real values out of this file.

# From @BotFather.
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Encrypts athletes' WodBuster passwords at rest (AES-GCM).
# MUST be exactly 16, 24 or 32 bytes. Generate one with:
#   openssl rand -hex 16
ENCRYPTION_KEY=local-dev-key-do-not-use-in-prod

# The box subdomain: <box>.wodbuster.com
WODBUSTER_BOX=firespain

# The opening is a wall-clock time at the gym, so this is the gym's zone,
# not the server's.
WODBUSTER_TIMEZONE=Europe/Madrid

LOGGING_LEVEL=DEBUG

# Where a failed login leaves an HTML dump (passwords stripped) and a
# screenshot. Empty turns it off. In a container, mount a volume here to keep
# the files after a restart; otherwise `docker cp` them out.
#WODBUSTER_DIAGNOSTICS_DIR=/tmp/wodbuster-diagnostics

# Athletes log in one at a time, each this long after the previous login
# finished, so the Sunday run does not hit the login with every browser at
# once. 0 lets them run side by side.
#WODBUSTER_LOGIN_GAP=20s
# Log in with "remember this device", so stored sessions last (45-day sliding
# expiry). Set to false to log in "just once", as before.
#WODBUSTER_TRUST_DEVICE=true
# When stored sessions are checked and renewed (cron, gym's zone). Empty turns
# it off.
#SESSION_REFRESH_CRON=0 3,15 * * *
# Sunday preflight: log everyone in an hour before the opening (cron, gym's
# zone). Empty turns it off.
#SESSION_PREFLIGHT_CRON=0 11 * * 0
# off: no stored sessions, no refresh, no preflight; log in at 11:50 as before.
# shadow: log in at 11:00 and book with that session; the days-old stored
# session is only checked. (live: not built yet.)
#SESSION_REUSE=shadow
# false: the admins hear from the Sunday preflight only when a login failed.
#SESSION_PREFLIGHT_ALL_OK_MESSAGE=true

# When the daily login check runs, as a cron spec in WODBUSTER_TIMEZONE. It logs
# in with the first admin's account (role "admin" in the users collection).
# Empty turns it off.
#LOGIN_CHECK_CRON=0 10 * * *

# Run a published release instead of building locally. Leave unset for a local
# build; see `make release`.
#   WODBUSTER_IMAGE=<dockerhub-user>/wodbuster-bot:v1.2.3
#WODBUSTER_IMAGE=
