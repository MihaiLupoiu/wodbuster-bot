# Copy to .env and fill in. .env is gitignored; .env.example is not, so keep
# real values out of this file.

# From @BotFather.
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Encrypts athletes' WodBuster passwords at rest (AES-GCM).
# MUST be exactly 16, 24 or 32 bytes. Generate one with:
#   openssl rand -hex 16
ENCRYPTION_KEY=local-dev-key-do-not-use-in-prod

# The box subdomain: <box>.wodbuster.com
WODBUSTER_BOX=firespain

# The opening is a wall-clock time at the gym, so this is the gym's zone,
# not the server's.
WODBUSTER_TIMEZONE=Europe/Madrid

LOGGING_LEVEL=DEBUG
